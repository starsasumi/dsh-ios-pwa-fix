{
  "name": "dsh-ios-pwa-fix",
  "version": "1.2.0",
  "description": "Keep the DSH web GUI usable as an iPhone and iPad Home Screen app: status bar, on-screen keyboard, and an optional key bar with switchable groups.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "release-notes.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "ios",
    "ipados",
    "pwa",
    "standalone",
    "keyboard",
    "keybar",
    "escape",
    "arrow-keys",
    "safe-area",
    "visualviewport"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node scripts/verify.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starsasumi/dsh-ios-pwa-fix.git"
  },
  "homepage": "https://github.com/starsasumi/dsh-ios-pwa-fix#readme",
  "bugs": {
    "url": "https://github.com/starsasumi/dsh-ios-pwa-fix/issues"
  }
}
